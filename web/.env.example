# Copier ce fichier vers web/.env. Git ignore le fichier réel.
# Aucune valeur ci-dessous n'est un secret utilisable.
# Node.js requis : 24.22.2. Base locale uniquement : 127.0.0.1:5433 / unica_mosaic_local.
# Le compte administrateur n'est pas créé au démarrage. Le script seed:admin est manuel et refuse NODE_ENV=production.

DATABASE_URL=postgresql://unica_local:remplacer@127.0.0.1:5433/unica_mosaic_local
PAYLOAD_SECRET=remplacer-par-une-chaine-longue
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# URL publique du site (retour Stripe). En local : http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Stripe — UNIQUEMENT des clés de test UNICA (sk_test_ / pk_test_ / whsec_).
# Ne jamais renseigner de clé live (sk_live_).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optionnel côté navigateur si besoin d’Elements plus tard :
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Notifications réservation (quand le service d’envoi sera branché)
BOOKING_NOTIFY_EMAIL=
# SMTP_URL=
# RESEND_API_KEY=
