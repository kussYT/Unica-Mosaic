{
  "name": "unica-mosaic-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node ./scripts/sync-public.mjs && cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1 --port 3000",
    "build": "node ./scripts/sync-public.mjs && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "node ./scripts/sync-public.mjs && cross-env NODE_OPTIONS=--no-deprecation next start --hostname 127.0.0.1 --port 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed:admin": "cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env --import tsx ./scripts/ensure-admin.ts",
    "seed:workshops": "cross-env NODE_OPTIONS=--no-deprecation node --env-file=.env --import tsx ./scripts/seed-workshops.ts",
    "verify": "node --env-file=.env ./scripts/verify.mjs && node --env-file=.env --import tsx ./scripts/verify-catalog.ts && node --env-file=.env --import tsx ./scripts/verify-reservations.ts && node --env-file=.env --import tsx ./scripts/verify-stripe-booking.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "cross-env": "7.0.3",
    "graphql": "16.11.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@types/node": "24.10.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sass": "1.108.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  }
}
