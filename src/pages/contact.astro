---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
---
<Layout title="Parlons de votre projet" description="Une création sur mesure, un atelier ou un projet de groupe : préparez votre demande pour UNICA.">
  <section class="contact-section wrap"><div class="contact-copy"><p class="eyebrow">TOUT COMMENCE PAR UNE ENVIE</p><h1>Une idée ?<br /><em>Parlons-en.</em></h1><p>Une pièce pour chez vous, un cadeau à imaginer, un moment à partager… Racontez-nous le petit morceau d’histoire que vous avez en tête.</p><Photo name="atelier-mains" alt="Une création en mosaïque prend forme, tesselle après tesselle." /><span class="photo-caption">LES BELLES HISTOIRES COMMENCENT PAR UN PREMIER MORCEAU.</span></div><div class="contact-panel"><h2>Votre projet, en quelques mots.</h2><p class="contact-notice">{site.email ? 'Ce formulaire prépare un e-mail à envoyer depuis votre messagerie.' : 'La prise de contact en ligne arrive bientôt. Vous pouvez déjà préparer et télécharger votre demande. Aucun message ne sera envoyé.'}</p><form id="contact-form" data-email={site.email}><label>Votre prénom <input name="prenom" autocomplete="given-name" required maxlength="80" placeholder="Comment vous appelez-vous ?" /></label><label>Votre adresse e-mail <input type="email" name="email" autocomplete="email" required maxlength="200" placeholder="vous@exemple.fr" /></label><label>Votre envie <select name="sujet" id="sujet"><option>Création sur mesure</option><option>Recolle-toi meuf</option><option>Pixel Kids</option><option>Ma croix, mes couleurs</option><option>Numéro de maison</option><option>Atelier en groupe</option><option>Autre envie</option></select></label><label>Racontez-nous <textarea name="message" rows="5" required minlength="10" maxlength="4000" placeholder="L’idée, les couleurs, l’occasion, la période souhaitée…"></textarea></label><button class="button" type="submit">{site.email ? 'Préparer mon e-mail' : 'Préparer ma demande'} <span aria-hidden="true"><Icon name="ne" /></span></button><p class="form-privacy">Vos informations restent dans cette page et ne sont pas transmises automatiquement.</p></form><div id="draft-result" hidden><h3>Votre demande est prête.</h3><p id="draft-explanation">Elle n’a pas été envoyée. Vous pouvez en conserver une copie.</p><textarea id="draft-text" rows="8" readonly aria-label="Votre demande préparée"></textarea><div class="draft-actions"><button type="button" class="button button-small" id="copy-draft">Copier le texte</button><button type="button" class="text-link" id="download-draft">Télécharger (.txt) <span aria-hidden="true"><Icon name="down" /></span></button></div><p id="draft-status" role="status" aria-live="polite"></p></div><noscript><p>Activez JavaScript pour préparer votre demande dans cette version de travail.</p></noscript></div></section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form')!;
    const select = document.querySelector<HTMLSelectElement>('#sujet')!;
    const requested = new URLSearchParams(location.search).get('sujet');
    if (requested && [...select.options].some(o => o.value === requested)) select.value = requested;
    const result = document.querySelector<HTMLElement>('#draft-result')!;
    const draft = document.querySelector<HTMLTextAreaElement>('#draft-text')!;
    form.addEventListener('submit', event => {
      event.preventDefault(); const data = new FormData(form);
      draft.value = `Bonjour Marie,\n\nJe vous contacte pour : ${data.get('sujet')}.\n\n${data.get('message')}\n\n${data.get('prenom')}\n${data.get('email')}`;
      result.hidden = false; result.scrollIntoView({behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block:'nearest'}); draft.focus();
      if(form.dataset.email) location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('UNICA — '+String(data.get('sujet')))}&body=${encodeURIComponent(draft.value)}`;
    });
    document.querySelector('#copy-draft')!.addEventListener('click', async () => { try { await navigator.clipboard.writeText(draft.value); document.querySelector('#draft-status')!.textContent = 'Le texte a été copié.'; } catch { draft.focus(); draft.select(); document.querySelector('#draft-status')!.textContent = 'Sélectionnez et copiez le texte, ou téléchargez votre demande.'; } });
    document.querySelector('#download-draft')!.addEventListener('click', () => { const url = URL.createObjectURL(new Blob([draft.value], {type:'text/plain;charset=utf-8'})); const a = document.createElement('a'); a.href = url; a.download = 'ma-demande-unica.txt'; a.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); document.querySelector('#draft-status')!.textContent = 'Votre demande a été téléchargée. Elle n’a pas été envoyée.'; });
  </script>
</Layout>
