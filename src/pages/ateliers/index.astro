---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { workshops } from '../../data/site';
---
<Layout title="Les ateliers créatifs" description="Découvrez les ateliers UNICA : Recolle-toi meuf, Pixel Kids, Ma croix mes couleurs et Numéro de maison.">
  <section class="page-hero pink-hero"><div class="wrap split"><div><p class="eyebrow">DU TEMPS POUR CRÉER. DU PLAISIR À PARTAGER.</p><h1>On recolle.<br />On crée.<br /><em>On se retrouve.</em></h1><p>Choisir ses couleurs, assembler ses idées et voir naître quelque chose de ses mains. Bienvenue aux ateliers UNICA.</p><a class="button button-yellow" href="#les-ateliers">Trouver mon atelier <span aria-hidden="true"><Icon name="down" /></span></a></div><Photo name="atelier-partage" alt="Des participantes sourient et créent ensemble à l’atelier UNICA." eager class="hero-portrait" /></div></section>
  <section class="section wrap" id="les-ateliers"><div class="section-heading"><div><p class="eyebrow">QUATRE ENVIES DE CRÉER</p><h2>À chacun<br /><em>son petit morceau.</em></h2></div><p>Des univers différents, un même plaisir : faire de ses mains. Découvrez l’esprit de chaque atelier.</p></div><div class="workshop-grid">{workshops.map((w,index) => <WorkshopCard workshop={w} index={index} />)}</div><p class="quiet-note">Les prochaines dates, les tarifs et les modalités de chaque atelier seront annoncés prochainement.</p></section>
  <section class="steps-section section wrap"><p class="eyebrow">L’ESPRIT D’UN ATELIER</p><h2>Un morceau après l’autre.</h2><div class="steps"><article><span>01</span><h3>On s’inspire</h3><p>Des matières, des couleurs et des exemples pour laisser venir les idées.</p></article><article><span>02</span><h3>On compose</h3><p>On découvre le geste, on assemble et on donne sa propre personnalité à la création.</p></article><article><span>03</span><h3>On partage</h3><p>Un moment autour de la table, des échanges et le plaisir de voir son idée prendre forme.</p></article></div></section>
  <section class="faq-section section wrap"><div><p class="eyebrow">AVANT DE SE LANCER</p><h2>Les petites<br /><em>questions.</em></h2></div><div class="faq-list"><details><summary>Comment connaître les prochaines dates ?</summary><p>Le calendrier est en préparation. La page de chaque atelier sera complétée avec les dates et les modalités de réservation.</p></details><details><summary>Quel atelier choisir pour un enfant ?</summary><p>Pixel Kids est l’univers dédié aux enfants. L’âge conseillé et les conditions d’accompagnement seront précisés pour chaque séance.</p></details><details><summary>Peut-on imaginer un atelier en groupe ?</summary><p>Une envie de moment créatif à plusieurs ? Préparez votre demande en indiquant l’occasion, le nombre de participants et la période souhaitée.</p><a class="text-link" href="/contact/?sujet=Atelier%20en%20groupe">Préparer mon projet de groupe <span aria-hidden="true"><Icon name="right" /></span></a></details></div></section>
  <CallToAction title="Une envie de créer à plusieurs ?" text="Un anniversaire, une occasion particulière ou simplement le plaisir de se retrouver autour d’une table." />
</Layout>
