---
const { title = 'Et si on créait quelque chose ensemble ?', text = 'Une idée, une envie, un projet encore un peu flou ? Tout commence par une conversation.' } = Astro.props;
---
<section class="cta-section"><span class="eyebrow">À VOUS DE JOUER</span><h2>{title}</h2><p>{text}</p><a class="button button-yellow" href="/contact/">Parlons-en <span aria-hidden="true">↗</span></a><span class="tile tile-a" aria-hidden="true"></span><span class="tile tile-b" aria-hidden="true"></span></section>
