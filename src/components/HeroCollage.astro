---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
---
<div class="hero-art">
  <img class="mosaic-band mosaic-edge-shield" src="/images/mosaic/edge-shield.svg" alt="" />
  <img class="mosaic-band mosaic-edge-low" src="/images/mosaic/edge-low.svg" alt="" />
  <div class="hero-photo hero-photo-shield">
    <Photo name="blason" alt="Un blason minutieusement réalisé en mosaïque dorée, noire et rouge." eager sizes="(max-width: 760px) 72vw, 36vw" />
  </div>
  <img class="mosaic-band mosaic-edge-leopard" src="/images/mosaic/edge-leopard.svg" alt="" />
  <div class="hero-photo hero-photo-leopard">
    <Photo name="dalida" alt="Gros plan sur une création en mosaïque au motif léopard." eager sizes="(max-width: 760px) 58vw, 28vw" />
  </div>
  <div class="hero-stamp">CHAQUE PIÈCE<br /><em>est unique.</em><span aria-hidden="true"><Icon name="star" /></span></div>
</div>
