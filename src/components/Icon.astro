---
interface Props {
  name: 'ne' | 'right' | 'left' | 'down' | 'star'
}
const { name } = Astro.props
const star = name === 'star'
const marks = {
  ne: { viewBox: '6 6 12 12', d: 'M7 17 17 7M17 7H10M17 7v7' },
  right: { viewBox: '4 4 16 16', d: 'M5 12h14M12 6l7 6-7 6' },
  left: { viewBox: '4 4 16 16', d: 'M19 12H5M12 6 5 12l7 6' },
  down: { viewBox: '4 4 16 16', d: 'M12 5v14M6 12l6 7 6-7' },
  star: { viewBox: '0 0 24 24', d: 'M12 2.6v18.8M2.6 12h18.8M5.2 5.2l13.6 13.6M18.8 5.2 5.2 18.8' },
} as const
const mark = marks[name]
---
<svg class={star ? 'icon-star' : 'icon-arrow'} viewBox={mark.viewBox} aria-hidden="true" focusable="false">
  <path d={mark.d} fill="none" stroke="currentColor" stroke-width={star ? 1.7 : 2.2} stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
