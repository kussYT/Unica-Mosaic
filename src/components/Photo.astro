---
interface Props { name: string; alt: string; class?: string; eager?: boolean; sizes?: string; }
const { name, alt, class: className = '', eager = false, sizes = '(max-width: 700px) 100vw, 50vw' } = Astro.props;
---
<img class={className} src={`/images/${name}-960.webp`} srcset={`/images/${name}-480.webp 480w, /images/${name}-960.webp 960w, /images/${name}-1600.webp 1600w`} sizes={sizes} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" width="960" height="1280" />
